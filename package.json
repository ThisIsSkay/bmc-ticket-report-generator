{
  "name": "bmc-ticket-report-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "build:gh-pages": "tsc -b && vite build --mode github-pages",
    "test:survey": "node --test prototype/customer-survey/test/*.checks.mjs",
    "test:email": "node --test prototype/daily-email/test/*.test.mjs",
    "golden:check": "node scripts/golden/check.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "verify:unified": "node scripts/verify-unified.mjs",
    "verify:export-scope": "node scripts/verify-export-scope.mjs",
    "verify:xlsx-dimension": "node scripts/verify-xlsx-dimension.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.5",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
